# Agent configuration — copy this to .env and fill in values
# DO NOT commit .env to git (it's in .gitignore)

# UUID assigned when the agent was registered via POST /api/v1/agents
AGENT_ID=00000000-0000-0000-0000-000000000000

# Raw API key returned once at agent registration
AGENT_API_KEY=REPLACE_WITH_KEY_FROM_REGISTRATION

# Base URL of the FastAPI backend (use Tailscale IP in production)
BACKEND_URL=https://100.64.0.1

# How often to collect and send metrics (seconds)
COLLECT_INTERVAL_SEC=30
