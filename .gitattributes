# Normalize line endings for all text files
* text=auto

# Force LF for files mounted into Linux containers
*.sh       text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
Dockerfile text eol=lf
*.env      text eol=lf
*.sql      text eol=lf
*.py       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.nginx    text eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pkl  binary
*.joblib binary
