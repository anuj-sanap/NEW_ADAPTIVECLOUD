# Environment Configuration Template
# Copy to .env in repository root and adapt for your local environment

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_only@postgres:5432/adaptivecloud

# Security & Authentication
JWT_SECRET=adaptivecloud_development_secret_key_change_in_production_min32chars
AGENT_API_KEY=adm-agent-live-insecure-dev-key-change-in-production

# Integrations
WAZUH_ALERTS_PATH=/var/ossec/logs/alerts/alerts.json

# Web & Networking
ALLOWED_ORIGINS=["http://localhost:5173","https://localhost","http://localhost"]
DOMAIN=localhost

# Development settings
DEBUG=true
ENVIRONMENT=development
POSTGRES_PASSWORD=postgres_dev_only

