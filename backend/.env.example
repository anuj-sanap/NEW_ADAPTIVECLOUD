# backend/.env.example — copy to backend/.env and fill in secrets
# DO NOT commit .env to git

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_only@postgres:5432/adaptivecloud

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_32_CHAR_RANDOM_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173","https://localhost"]

# ── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml-service:8001
ML_ALERT_THRESHOLD=0.80
ML_INFERENCE_ENABLED=true

# ── Wazuh (disable until Wazuh container is running) ─────────────────────────
WAZUH_ENABLED=false
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE_ME

